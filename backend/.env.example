APP_NAME=OpenCall API
DEBUG=false
# Server-only Supabase Postgres URL; percent-encode reserved password characters.
DATABASE_URL=
# Download the project server root certificate from Supabase Database settings.
# DATABASE_SSL_ROOT_CERT=/absolute/path/to/supabase-ca.crt
# Deployment alternative: certificate PEM contents as an environment variable.
# DATABASE_SSL_ROOT_CERT_PEM=
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service.json
# Production alternative: full Firebase service-account JSON, stored as a secret.
# FIREBASE_SERVICE_ACCOUNT_JSON=
GNANI_API_KEY=
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Continuous voice conversations: LiveKit local dev defaults below.
GROQ_API_KEY=
# Optional: agriculture-related places search.
GEOAPIFY_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=qwen/qwen3.8-27b
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CONVERSATION_MAX_SECONDS=1800

# Local voice worker health port used by the dev launcher and API.
VOICE_WORKER_PORT=8081
# Production API: set cloud LIVEKIT_URL and credentials, and set this true.
# The local bun dev launcher always overrides these with local values.
VOICE_AGENT_REMOTE=false
